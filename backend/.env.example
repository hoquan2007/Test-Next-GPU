# Server
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/user_images_db?schema=public"

# Storage
STORAGE_DRIVER=local
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10
ALLOWED_MIME_TYPES=image/jpeg,image/png,image/webp,image/gif

# AWS S3 (optional - set STORAGE_DRIVER=s3)
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Image processing
THUMBNAIL_WIDTH=200
THUMBNAIL_HEIGHT=200
MEDIUM_WIDTH=800
MEDIUM_HEIGHT=800
